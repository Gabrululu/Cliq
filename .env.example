WDK_NETWORK=testnet
WDK_RPC_URL=
MERCHANT_SEED_PHRASE=
WDK_USDT_CONTRACT=
WDK_USDT_DECIMALS=6
WDK_NATIVE_SYMBOL=ETH
QVAC_MODEL=LLAMA_3_2_1B_INST_Q4_0
QVAC_LOAD_TIMEOUT_MS=120000

# "merchant agent settle" (WDK Track 1: @tetherto/wdk-cli + MCP)
# Requiere "wdk wallet import" + "wdk wallet unlock --ttl 0" corridos una vez
# a mano (ver README). El agente solo puede pagar facturas ya existentes, al
# destinatario que ya tienen, y nunca por mas de este tope.
AGENT_SPEND_CAP_USDT=10
AGENT_WDK_NETWORK=sepolia
AGENT_WDK_TOKEN_SYMBOL=tpusdt
AGENT_WDK_FROM_INDEX=1

# "merchant gasless pay" (WDK Track 2: modulo gasless ERC-4337 + paymaster)
# Requiere haber creado la network "smart-account-sepolia-pimlico" en wdk-cli
# (ver README, seccion WDK Track 2) y tu propia API key de Pimlico.
PIMLICO_API_KEY=
GASLESS_WDK_NETWORK=smart-account-sepolia-pimlico
GASLESS_WDK_TOKEN_SYMBOL=usdt
GASLESS_WDK_FROM_INDEX=1
