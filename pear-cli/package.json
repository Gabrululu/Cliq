{
  "name": "cliq-cli",
  "productName": "cliq",
  "version": "0.0.5",
  "description": "CLIQ CLI - terminal de pagos P2P para pequenos comercios (Pear track submission, sin el asistente QVAC).",
  "private": true,
  "bin": "bin.mjs",
  "upgrade": "pear://mp8yxd4xro9apkxpsgp34upeuqhdyhem64r7wbtqigjuac9qqemo",
  "pear": {
    "name": "cliq-cli",
    "stage": {
      "ignore": [
        ".env",
        ".cliq",
        ".git",
        "out"
      ]
    }
  },
  "scripts": {
    "format": "prettier . --write",
    "test": "brittle-bare test/index.js",
    "lint": "prettier . --check && lunte",
    "start": "bare bin.mjs --no-updates",
    "make": "node scripts/make.js",
    "make:darwin-arm64": "bare-build --name cliq --standalone --host darwin-arm64 --out ./out/darwin-arm64 bin.mjs",
    "make:darwin-x64": "bare-build --name cliq --standalone --host darwin-x64 --out ./out/darwin-x64 bin.mjs",
    "make:linux-arm64": "bare-build --name cliq --standalone --host linux-arm64 --out ./out/linux-arm64 bin.mjs",
    "make:linux-x64": "bare-build --name cliq --standalone --host linux-x64 --out ./out/linux-x64 bin.mjs",
    "make:win32-arm64": "bare-build --name cliq --standalone --host win32-arm64 --out ./out/win32-arm64 bin.mjs",
    "make:win32-x64": "bare-build --name cliq --standalone --host win32-x64 --out ./out/win32-x64 bin.mjs"
  },
  "dependencies": {
    "bare-abort": "^2.0.13",
    "bare-compat-napi": "^1.3.9",
    "bare-console": "^6.2.0",
    "bare-daemon": "^1.2.4",
    "bare-env": "^3.0.1",
    "bare-events": "^2.9.1",
    "bare-file-logger": "^1.2.1",
    "bare-format": "^1.0.2",
    "bare-fs": "^4.7.2",
    "bare-hrtime": "^2.0.0",
    "bare-logger": "^2.0.0",
    "bare-os": "^3.9.0",
    "bare-path": "^3.0.0",
    "bare-posix": "^1.0.1",
    "bare-process": "^4.5.0",
    "bare-sidecar": "^0.5.2",
    "bare-signals": "^5.0.0",
    "bare-stdio": "^1.0.1",
    "bare-storage": "^1.1.0",
    "bare-stream": "^2.6.4",
    "bare-system-logger": "^1.0.2",
    "bare-type": "^1.1.0",
    "bare-url": "^2.2.2",
    "bare-worker": "^4.4.0",
    "corestore": "^7.9.2",
    "fs-native-extensions": "^1.5.0",
    "hypercore-crypto": "^3.7.0",
    "hyperswarm": "^4.17.0",
    "paparam": "^1.10.1",
    "pear-runtime": "^1.1.4",
    "ready-resource": "^1.2.0",
    "which-runtime": "^1.4.0",
    "@tetherto/wdk": "^1.0.0-beta.16",
    "@tetherto/wdk-wallet-evm": "^1.0.0-beta.17"
  },
  "devDependencies": {
    "bare-build": "^1.0.1",
    "bare-runtime": "^1.29.5",
    "brittle": "^3.19.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "author": "",
  "license": "MIT"
}
